# OpenAI-Compatible LLM API
OPENAI_BASE_URL=http://127.0.0.1:8045/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gemini-3-flash
OPENAI_FILTER_MODEL=gemini-3-flash
OPENAI_DECISION_MODEL=gemini-3-flash

# Server & Database (binds to 127.0.0.1 by default; ADMIN_PASSWORD fails closed if unset or 'change_me')
HOST=127.0.0.1
PORT=3001
MILICENT_DB_PATH=data/milicent.db
ADMIN_PASSWORD=replace_with_strong_secret
CORS_ORIGINS=http://localhost:3000

# Optional Proxy for News WAF Bypass
CRAWLER_PROXY_URL=
CRAWLER_PROXY_TOKEN=
YAHOO_USE_PROXY=false

# Optional Telegram Notifications & Polling (comma-separated chat IDs required when polling is enabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=false
TELEGRAM_ALLOWED_CHAT_IDS=
